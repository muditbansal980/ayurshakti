# Compose works with these local-development defaults even without a .env file.
# These are local-only credentials, not an Atlas account.
MONGO_USERNAME=sakti
MONGO_PASSWORD=REDACTED-LOCAL-PASSWORD
MONGODB_DB=sakti_sahayak
MONGODB_PORT=27017
BACKEND_PORT=8000
FRONTEND_PORT=3000
MONGODB_IMAGE=mongodb/mongodb-atlas-local:8.0

