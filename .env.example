[TEMPLATE]
# Copy this file to .env and fill in real values. .env is gitignored.
# Compose refuses to start without MONGO_USERNAME and MONGO_PASSWORD.
# These are local-development credentials, not an Atlas account.
MONGO_USERNAME=
MONGO_PASSWORD=
MONGODB_DB=sakti_sahayak
MONGODB_PORT=27017
BACKEND_PORT=8000
FRONTEND_PORT=3000
MONGODB_IMAGE=mongodb/mongodb-atlas-local:8.0
