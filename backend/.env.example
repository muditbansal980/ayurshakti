[TEMPLATE]
# Copy this file to backend/.env for native (non-Docker) runs. It is gitignored.
# Optional override for an external MongoDB deployment; leave empty for local Docker.
MONGODB_URI=
MONGODB_DB=sakti_sahayak
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
# Docker uses cpu. A native macOS installation can use mps after installing torch.
EMBEDDING_DEVICE=cpu
